// Message and scroll speed
char msg[] = " Electronics Workshop 2025 "; // Add trailing space
int scrollspeed = 5; // Lower = faster scroll

// Shift register pins for columns
int clockPin1 = 3; 
int latchPin1 = 2; 
int dataPin1 = 4;

// Shift register pins for rows
int clockPin2 = 7; 
int latchPin2 = 6; 
int dataPin2 = 5;

// Display buffer: 8 rows x 6 zones (6 x 8 columns = 48 columns)
byte bitmap[8][6];

int numZones = sizeof(bitmap[0]);  // 6 zones (48 columns)
int maxZoneIndex = numZones - 1;
int numCols = numZones * 8;

